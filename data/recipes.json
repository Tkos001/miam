      "remoteId": "butternut-farcie-boeuf",
      "name": "Courge butternut farcie au bœuf haché",
      "description": "Une grosse butternut coupée en deux, une moitié par personne, garnie de 500 g de bœuf haché à la crème et bien gratinée.",
      "prepMinutes": 15,
      "cookMinutes": 60,
      "servings": 2,
      "cuisine": "FRANCAISE",
